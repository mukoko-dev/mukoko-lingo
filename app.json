{
  "expo": {
    "name": "Mukoko Lingo",
    "slug": "mukoko-lingo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mukokolingo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0047AB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mukoko.lingo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0047AB"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mukoko.lingo"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f52e4480-5296-41d2-8090-356d30dfdac8"
      }
    },
    "owner": "nyuchi-web-services"
  }
}
