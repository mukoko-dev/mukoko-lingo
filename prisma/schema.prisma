// Prisma schema for MongoDB
// Migrated from Supabase (PostgreSQL) to MongoDB Atlas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// =============================================================================
// User & Authentication
// =============================================================================

model Profile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  stytchUserId     String   @unique @map("stytch_user_id")
  email            String   @unique
  displayName      String?  @map("display_name")
  role             String   @default("user") // "user" | "admin"
  status           String   @default("active") // "active" | "inactive" | "banned" | "pending"
  preferredUiLang  String   @default("en") @map("preferred_ui_language")
  learningGoal     String?  @map("learning_goal")
  dailyGoal        Int      @default(10) @map("daily_goal")
  studyStreak      Int      @default(0) @map("study_streak")
  lastStudyDate    DateTime? @map("last_study_date")
  lastActive       DateTime  @default(now()) @map("last_active")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  phraseProgress     PhraseProgress[]
  bookmarks          Bookmark[]
  phraseViews        PhraseView[]
  studySessions      StudySession[]
  userSkills         UserSkill[]
  userAssessments    UserAssessment[]
  aiGeneratedPhrases AiGeneratedPhrase[]
  aiConversations    AiConversation[]
  aiRecommendations  AiRecommendation[]
  moderationAlerts   ModerationAlert[]   @relation("AlertUser")
  reviewedAlerts     ModerationAlert[]   @relation("AlertReviewer")
  resolvedAlerts     ModerationAlert[]   @relation("AlertResolver")
  createdAssessments Assessment[]        @relation("AssessmentCreator")
  createdStandards   LearningStandard[]  @relation("StandardCreator")
  createdGuardrails  Guardrail[]         @relation("GuardrailCreator")
  approvedPhrases    AiGeneratedPhrase[] @relation("PhraseApprover")

  @@map("profiles")
}

// =============================================================================
// Phrase Learning
// =============================================================================

model Phrase {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  category              String
  english               String
  englishPronunciation  String?  @map("english_pronunciation")
  englishContext        String?  @map("english_context")
  shona                 String
  shonaPronunciation    String?  @map("shona_pronunciation")
  shonaContext          String?  @map("shona_context")
  ndebele               String
  ndebelePronunciation  String?  @map("ndebele_pronunciation")
  ndebeleContext        String?  @map("ndebele_context")
  chinese               String
  chinesePronunciation  String?  @map("chinese_pronunciation")
  chineseContext        String?  @map("chinese_context")
  difficulty            String   @default("beginner") // "beginner" | "intermediate" | "advanced"
  skillId               String?  @map("skill_id") @db.ObjectId
  requiredProficiency   String?  @map("required_proficiency")
  createdAt             DateTime @default(now()) @map("created_at")

  // Relations
  skill              Skill?           @relation(fields: [skillId], references: [id])
  phraseProgress     PhraseProgress[]
  bookmarks          Bookmark[]
  phraseViews        PhraseView[]
  aiRecommendations  AiRecommendation[]

  @@map("phrases")
}

model PhraseProgress {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @map("user_id") @db.ObjectId
  phraseId        String   @map("phrase_id") @db.ObjectId
  status          String   // "learning" | "practiced" | "mastered"
  timesPracticed  Int      @default(1) @map("times_practiced")
  lastPracticedAt DateTime @default(now()) @map("last_practiced_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase Phrase  @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@unique([userId, phraseId])
  @@map("phrase_progress")
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  phraseId  String   @map("phrase_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase Phrase  @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@unique([userId, phraseId])
  @@map("bookmarks")
}

model PhraseView {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String?  @map("user_id") @db.ObjectId
  phraseId String   @map("phrase_id") @db.ObjectId
  viewedAt DateTime @default(now()) @map("viewed_at")

  // Relations
  user   Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase Phrase   @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@map("phrase_views")
}

model StudySession {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @map("user_id") @db.ObjectId
  sessionDate      DateTime @default(now()) @map("session_date")
  phrasesStudied   Int      @default(0) @map("phrases_studied")
  timeSpentMinutes Int      @default(0) @map("time_spent_minutes")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionDate])
  @@map("study_sessions")
}

// =============================================================================
// Skills-Based Learning
// =============================================================================

model Skill {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique // "pronunciation" | "vocabulary" | "grammar" | "comprehension" | "conversation"
  displayName Json     @map("display_name") // { en, sn, nd, zh }
  description Json     // { en, sn, nd, zh }
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  phrases      Phrase[]
  skillLevels  SkillLevel[]
  userSkills   UserSkill[]
  assessments  Assessment[]

  @@map("skills")
}

model SkillLevel {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  skillId     String   @map("skill_id") @db.ObjectId
  level       String   // "beginner" | "elementary" | "intermediate" | "advanced" | "fluent"
  displayName Json     @map("display_name") // { en, sn, nd, zh }
  description Json     // { en, sn, nd, zh }
  minScore    Int      @map("min_score")
  sortOrder   Int      @default(0) @map("sort_order")

  // Relations
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, level])
  @@map("skill_levels")
}

model UserSkill {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @map("user_id") @db.ObjectId
  skillId           String    @map("skill_id") @db.ObjectId
  currentLevel      String    @default("beginner") @map("current_level")
  currentScore      Int       @default(0) @map("current_score")
  totalPracticeTime Int       @default(0) @map("total_practice_time") // seconds
  lastPracticedAt   DateTime? @map("last_practiced_at")
  levelAchievedAt   DateTime  @default(now()) @map("level_achieved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Assessment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  skillId      String   @map("skill_id") @db.ObjectId
  type         String   // "diagnostic" | "formative" | "summative"
  targetLevel  String   @map("target_level")
  title        Json     // { en, sn, nd, zh }
  description  Json?    // { en, sn, nd, zh }
  questions    Json     // Array of question objects
  passingScore Int      @default(70) @map("passing_score")
  timeLimit    Int?     @map("time_limit") // seconds
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  creator         Profile?         @relation("AssessmentCreator", fields: [createdBy], references: [id])
  userAssessments UserAssessment[]

  @@map("assessments")
}

model UserAssessment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @map("user_id") @db.ObjectId
  assessmentId String   @map("assessment_id") @db.ObjectId
  skillId      String   @map("skill_id") @db.ObjectId
  answers      Json     // Array of { question_id, answer, correct, points_earned, time_taken }
  score        Int
  passed       Boolean
  timeTaken    Int?     @map("time_taken") // seconds
  feedback     Json?    // { overall, skill_specific, next_steps }
  startedAt    DateTime @default(now()) @map("started_at")
  completedAt  DateTime @default(now()) @map("completed_at")

  // Relations
  user       Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("user_assessments")
}

model LearningStandard {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  level             String   @unique // "beginner" | "novice" | "advanced" | "fluent"
  levelOrder        Int      @map("level_order")
  title             String
  description       String
  criteria          Json     // vocabulary_size, sentence_complexity, etc.
  vocabularyRange   String?  @map("vocabulary_range")
  conversationTypes String[] @map("conversation_types")
  grammarConcepts   String[] @map("grammar_concepts")
  aiPromptTemplate  String?  @map("ai_prompt_template")
  examplePhrases    String[] @map("example_phrases")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.ObjectId

  // Relations
  creator Profile? @relation("StandardCreator", fields: [createdBy], references: [id])

  @@map("learning_standards")
}

// =============================================================================
// AI & Moderation
// =============================================================================

model AiGeneratedPhrase {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String?   @map("user_id") @db.ObjectId
  english               String
  shona                 String
  ndebele               String
  chinese               String
  englishPronunciation  String?   @map("english_pronunciation")
  shonaPronunciation    String?   @map("shona_pronunciation")
  ndebelePronunciation  String?   @map("ndebele_pronunciation")
  chinesePronunciation  String?   @map("chinese_pronunciation")
  context               String?
  category              String    @default("custom")
  source                String    @default("ai_generated")
  moderationFlagged     Boolean   @default(false) @map("moderation_flagged")
  moderationReason      String?   @map("moderation_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  approvedAt            DateTime? @map("approved_at")
  approvedBy            String?   @map("approved_by") @db.ObjectId

  // Relations
  user     Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver Profile? @relation("PhraseApprover", fields: [approvedBy], references: [id])

  @@map("ai_generated_phrases")
}

model AiConversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @map("user_id") @db.ObjectId
  type      String   // conversation type
  language  String
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     Profile?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId       String   @map("conversation_id") @db.ObjectId
  role                 String   // "user" | "assistant" | "system"
  content              String
  moderationFlagged    Boolean  @default(false) @map("moderation_flagged")
  moderationCategories Json?    @map("moderation_categories")
  createdAt            DateTime @default(now()) @map("created_at")

  // Relations
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model AiRecommendation {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @map("user_id") @db.ObjectId
  phraseId String   @map("phrase_id") @db.ObjectId
  reason   String?
  score    Float?
  shownAt  DateTime @default(now()) @map("shown_at")
  clicked  Boolean  @default(false)

  // Relations
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase Phrase  @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

model ModerationAlert {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?   @map("user_id") @db.ObjectId
  contentType String    @map("content_type")
  contentId   String?   @map("content_id") @db.ObjectId
  contentText String    @map("content_text")
  flaggedReason String? @map("flagged_reason")
  categories  Json      @default("{}") // moderation categories
  status      String    @default("pending") // "pending" | "reviewed" | "resolved"
  reviewedBy  String?   @map("reviewed_by") @db.ObjectId
  reviewedAt  DateTime? @map("reviewed_at")
  adminNotes  String?   @map("admin_notes")
  resolvedBy  String?   @map("resolved_by") @db.ObjectId
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user     Profile? @relation("AlertUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer Profile? @relation("AlertReviewer", fields: [reviewedBy], references: [id])
  resolver Profile? @relation("AlertResolver", fields: [resolvedBy], references: [id])

  @@map("moderation_alerts")
}

model Guardrail {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  description     String
  category        String   // "content" | "behavior" | "safety"
  ruleType        String   @map("rule_type") // "block" | "warn" | "allow"
  patterns        String[]
  keywords        String[]
  aiInstructions  String?  @map("ai_instructions")
  isActive        Boolean  @default(true) @map("is_active")
  severity        Int      @default(1) // 1-5
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.ObjectId

  // Relations
  creator Profile? @relation("GuardrailCreator", fields: [createdBy], references: [id])

  @@map("guardrails")
}
