# =============================================================================
# Mukoko Lingo Web App — Environment Variables
# =============================================================================

# API base URL (shared Vercel serverless functions)
NEXT_PUBLIC_API_BASE_URL=https://mukoko-lingo.vercel.app

# WorkOS AuthKit (client-side — Client ID is not secret)
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_your-workos-client-id
