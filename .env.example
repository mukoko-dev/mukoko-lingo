# =============================================================================
# MongoDB Configuration
# =============================================================================
# MongoDB Atlas connection string (mukoko-lingo cluster)
# IMPORTANT: Must include database name after the host (e.g., /mukoko_lingo)
MONGODB_URI=mongodb+srv://username:password@mukoko-lingo.xxxxx.mongodb.net/mukoko_lingo?retryWrites=true&w=majority

# =============================================================================
# Stytch Authentication
# =============================================================================
# Project: Mukoko Identity (Consumer)
# Dashboard: https://stytch.com/dashboard
# Pattern: Direct Stytch integration (same as BushTrade)
#
# Live Project ID: project-live-86090362-2491-4ca7-9037-f7688c7699ce
# Test Project ID: project-test-6add5f68-59c6-4086-88e8-8e0dc819a9a3
# Live IDP URL: https://id.mukoko.com/oauth/authorize
# User Impersonation: Enabled (live)
# User Lock: 10 attempts, 1hr TTL
#
# Client-side (exposed to mobile app)
EXPO_PUBLIC_STYTCH_PROJECT_ID=project-test-6add5f68-59c6-4086-88e8-8e0dc819a9a3
EXPO_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-test-1df5b714-c963-4f08-92b1-abafa2140635

# Server-side (Vercel API routes only - NEVER expose to client)
STYTCH_PROJECT_ID=project-test-6add5f68-59c6-4086-88e8-8e0dc819a9a3
STYTCH_PUBLIC_TOKEN=public-token-test-1df5b714-c963-4f08-92b1-abafa2140635
STYTCH_SECRET=your-stytch-secret-key

# For production, use:
# STYTCH_PROJECT_ID=project-live-86090362-2491-4ca7-9037-f7688c7699ce
# STYTCH_PUBLIC_TOKEN=public-token-live-110e4e1d-725e-4d5b-b519-8fbf5a1c0c9e

# Redirect URLs
STYTCH_REDIRECT_URL_WEB=https://lingo.mukoko.com/auth/callback
STYTCH_REDIRECT_URL_MOBILE=mukokolingo://auth/callback

# Email Template IDs (Optional - omit to use Stytch default templates)
# Only set these if you've created custom templates in the Stytch dashboard.
# If set to non-existent IDs, all OTP/magic link/password reset emails will fail.
STYTCH_TEMPLATE_LOGIN=mukoko_lingo_login
STYTCH_TEMPLATE_SIGNUP=mukoko_lingo_signup
STYTCH_TEMPLATE_RESET_PASSWORD=mukoko_lingo_reset_password
STYTCH_TEMPLATE_OTP=mukoko_lingo_otp

# Session duration (minutes) - Default: 7 days = 10080
STYTCH_SESSION_DURATION_MINUTES=10080

# Web client tokens
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-test-1df5b714-c963-4f08-92b1-abafa2140635
NEXT_PUBLIC_STYTCH_REDIRECT_URL=http://localhost:3000/auth/callback

# =============================================================================
# API Configuration
# =============================================================================
# Base URL for the backend API (Vercel serverless functions)
EXPO_PUBLIC_API_BASE_URL=https://your-api-domain.vercel.app

# Password Reset Redirect URL (Optional)
# Default: mukokolingo://reset-password (for mobile deep linking)
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=mukokolingo://reset-password
EXPO_PUBLIC_MAGIC_LINK_REDIRECT_URL=mukokolingo://auth/callback

# Deep link scheme (configure in app.json)
EXPO_PUBLIC_DEEP_LINK_SCHEME=mukokolingo

# =============================================================================
# AI Configuration
# =============================================================================
# Anthropic Claude API Key (for mobile AI tutor - Shamwari)
# Get your API key from: https://console.anthropic.com/
# Model used: claude-haiku-4-5-20251001
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vercel AI Gateway Configuration (for web API routes)
AI_GATEWAY_API_KEY=your_api_key_here

# Vercel OIDC Token (automatically set by Vercel)
# VERCEL_OIDC_TOKEN=auto-generated-by-vercel
