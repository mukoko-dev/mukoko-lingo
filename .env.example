# =============================================================================
# MongoDB Configuration
# =============================================================================
# Database: mukoko-lingo
# Server-side only (Vercel API routes + Python analytics) — SECRET, never expose
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mukoko-lingo

# =============================================================================
# WorkOS AuthKit
# =============================================================================
# Project: Nyuchi Identity's Project
# Dashboard: https://dashboard.workos.com
# Pattern: Hosted AuthKit sign-in (PKCE authorization-code flow), exchanged
# through the shared api/auth/* Vercel functions for both mobile and web.
#
# Environments: Staging (sandbox) and Production, one Client ID each.
#
# Server-side (Vercel API routes only - NEVER expose to client)
WORKOS_API_KEY=sk_test_your-workos-api-key
WORKOS_CLIENT_ID=client_your-workos-client-id

# Redirect URIs (must be registered as a redirect URI in the WorkOS dashboard)
WORKOS_REDIRECT_URI_WEB=https://lingo.mukoko.com/auth/callback
WORKOS_REDIRECT_URI_MOBILE=mukokolingo://auth/callback

# Client-side (exposed to mobile app — Client IDs are not secret)
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_your-workos-client-id
# Native only — the deep-link scheme. A browser has no handler for this, so the
# web build must never use it (see EXPO_PUBLIC_WORKOS_REDIRECT_URI_WEB).
EXPO_PUBLIC_WORKOS_REDIRECT_URI=mukokolingo://auth/callback

# Web only, and optional: leave unset and the web build uses the origin it is
# served from (`<origin>/auth/callback`), so localhost and preview deployments
# come back to themselves. Set it to pin every web build to one URI instead.
# Whichever URI is used must be registered on the WorkOS AuthKit application.
# EXPO_PUBLIC_WORKOS_REDIRECT_URI_WEB=https://lingo.mukoko.com/auth/callback

# Web client (exposed to the Next.js admin app)
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_your-workos-client-id

# =============================================================================
# API Configuration
# =============================================================================
# Base URL for the backend API (Vercel serverless functions)
EXPO_PUBLIC_API_BASE_URL=https://your-api-domain.vercel.app
# Same base URL for the Next.js web app (web/), which reads its own prefix
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.vercel.app

# Deep link scheme (configure in app.json)
EXPO_PUBLIC_DEEP_LINK_SCHEME=mukokolingo

# =============================================================================
# AI Configuration
# =============================================================================
# Cloudflare Workers AI, via Cloudflare AI Gateway (SERVER-SIDE ONLY —
# proxied through /api/ai/chat, so no credential reaches the client bundle).
# IMPORTANT: Do NOT use an EXPO_PUBLIC_ prefix on any of these.
#
# Account id: Cloudflare dashboard → Workers & Pages → Account details
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# API token with the "Workers AI" read/run permission:
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# AI Gateway to route inference through (dashboard → AI → AI Gateway).
# Optional: unset means requests go straight to Workers AI, which still works
# but loses gateway caching, rate limiting and request logs.
CLOUDFLARE_AI_GATEWAY_ID=your_gateway_id
# Only for a gateway set to "authenticated" — sent as cf-aig-authorization.
# CLOUDFLARE_AI_GATEWAY_TOKEN=your_gateway_token

# Model override. Default: @cf/qwen/qwen3-30b-a3b-fp8
# WORKERS_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Block chat when AI moderation can't run, instead of falling back to local
# guardrails only. Default (unset) is fail-open.
# AI_MODERATION_FAIL_CLOSED=true

# Vercel OIDC Token (automatically set by Vercel)
# VERCEL_OIDC_TOKEN=auto-generated-by-vercel

# =============================================================================
# API Key Hashing
# =============================================================================
# Server-side secret (pepper) for HMAC-hashing org-issued developer API keys
# before storing them in platform.apiKeys — keeps the stored hash unusable
# even if the database leaks, without it a leaked keyHashedSecret plus a
# rainbow table would be enough. Generate with: openssl rand -hex 32
API_KEY_HASH_SECRET=generate-a-random-64-char-hex-secret
