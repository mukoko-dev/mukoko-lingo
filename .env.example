# =============================================================================
# MongoDB Configuration
# =============================================================================
# Database: mukoko-lingo
# Server-side only (Vercel API routes + Python analytics) — SECRET, never expose
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mukoko-lingo

# =============================================================================
# WorkOS AuthKit
# =============================================================================
# Project: Nyuchi Identity's Project
# Dashboard: https://dashboard.workos.com
# Pattern: Hosted AuthKit sign-in (PKCE authorization-code flow), exchanged
# through the shared api/auth/* Vercel functions for both mobile and web.
#
# Environments: Staging (sandbox) and Production, one Client ID each.
#
# Server-side (Vercel API routes only - NEVER expose to client)
WORKOS_API_KEY=sk_test_your-workos-api-key
WORKOS_CLIENT_ID=client_your-workos-client-id

# Redirect URIs (must be registered as a redirect URI in the WorkOS dashboard)
WORKOS_REDIRECT_URI_WEB=https://lingo.mukoko.com/auth/callback
WORKOS_REDIRECT_URI_MOBILE=mukokolingo://auth/callback

# Client-side (exposed to mobile app — Client IDs are not secret)
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_your-workos-client-id
EXPO_PUBLIC_WORKOS_REDIRECT_URI=mukokolingo://auth/callback

# Web client (exposed to the Next.js admin app)
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_your-workos-client-id

# =============================================================================
# API Configuration
# =============================================================================
# Base URL for the backend API (Vercel serverless functions)
EXPO_PUBLIC_API_BASE_URL=https://your-api-domain.vercel.app

# Deep link scheme (configure in app.json)
EXPO_PUBLIC_DEEP_LINK_SCHEME=mukokolingo

# =============================================================================
# AI Configuration
# =============================================================================
# Anthropic Claude API Key (SERVER-SIDE ONLY — proxied via /api/ai/chat)
# Get your API key from: https://console.anthropic.com/
# Model used: claude-haiku-4-5-20251001
# IMPORTANT: Do NOT use EXPO_PUBLIC_ prefix — key must stay server-side
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vercel AI Gateway Configuration (for web API routes)
AI_GATEWAY_API_KEY=your_api_key_here

# Vercel OIDC Token (automatically set by Vercel)
# VERCEL_OIDC_TOKEN=auto-generated-by-vercel

# =============================================================================
# API Key Hashing
# =============================================================================
# Server-side secret (pepper) for HMAC-hashing org-issued developer API keys
# before storing them in platform.apiKeys — keeps the stored hash unusable
# even if the database leaks, without it a leaked keyHashedSecret plus a
# rainbow table would be enough. Generate with: openssl rand -hex 32
API_KEY_HASH_SECRET=generate-a-random-64-char-hex-secret
