# Supabase Configuration (Web/Next.js)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Configuration (Mobile/Expo)
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Password Reset Redirect URL (Optional)
# Default: nyuchilingo://reset-password (for mobile deep linking)
# Set this to your app's password reset deep link URL
# EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=nyuchilingo://reset-password
# NEXT_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://your-domain.com/auth/reset-password

# Development Mode - REMOVED FOR SECURITY
# Dev mode has been removed to prevent authentication bypass issues
# Use proper Supabase authentication for all environments
# NEXT_PUBLIC_DEV_MODE is no longer supported

# Vercel AI Gateway Configuration
# Get your gateway API key from: https://vercel.com/dashboard/ai-gateway
# This is used for both local development and production
AI_GATEWAY_API_KEY=your_api_key_here

# Vercel OIDC Token (automatically set by Vercel)
# VERCEL_OIDC_TOKEN=auto-generated-by-vercel
